---
const services = [
  {
    title: "Content + Narrative",
    description:
      "Messaging, editorial strategy, and multi-format content designed to ship weekly and compound.",
    bg: "bg-pink",
    text: "text-white",
    descText: "text-white/80",
  },
  {
    title: "Social + Community Loops",
    description:
      "Platform-native content ops and community activation that build trust, momentum, and repeatable growth.",
    bg: "bg-blue",
    text: "text-white",
    descText: "text-white/80",
  },
  {
    title: "Launch + Partnerships",
    description:
      "GTM planning and co-marketing with partners to expand distribution and accelerate launches.",
    bg: "bg-yellow",
    text: "text-dark",
    descText: "text-dark/70",
  },
  {
    title: "Video + Motion Production",
    description:
      "Concept to final cut. Social video, promos, and motion assets that earn attention and support the loop.",
    bg: "bg-coral",
    text: "text-white",
    descText: "text-white/80",
  },
  {
    title: "Analytics + Automation",
    description:
      "Agentic tool and system builds with \"human in the loop\" gates to increase KPI output and efficiency.",
    link: {
      label: "See Case Studies.",
      href: "https://canva.link/kj-agentic-casestudies",
    },
    bg: "bg-green",
    text: "text-white",
    descText: "text-white/80",
  },
  {
    title: "Operator Execution",
    description:
      "Cross-functional delivery with metrics tracking using API + MCP and standard marketing analytic tools.",
    bg: "bg-dark",
    text: "text-cream",
    descText: "text-cream/70",
  },
];
---

<section id="services" class="px-5 py-8 md:py-12 relative">
  <div class="mx-auto max-w-6xl">
    <h2
      class="reveal font-display font-bold text-4xl sm:text-5xl md:text-6xl tracking-tight mb-4 text-center"
    >
      How I Drive Growth
    </h2>
    <p class="reveal text-center text-dark/60 text-lg mb-10 font-body">
      Content-led GTM systems that convert attention into demand.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 reveal-stagger">
      {
        services.map((service) => (
          <div
            class={`reveal service-card ${service.bg} rounded-2xl p-7 flex flex-col`}
          >
            <h3 class={`font-display font-bold text-xl mb-3 ${service.text}`}>
              {service.title}
            </h3>
            <p
              class={`${service.descText} leading-relaxed text-[0.95rem] font-body`}
            >
              {service.description}
              {"link" in service && service.link && (
                <>
                  {" "}
                  <a
                    href={service.link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`underline underline-offset-2 hover:opacity-80 transition-opacity ${service.text}`}
                  >
                    {service.link.label}
                  </a>
                </>
              )}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
