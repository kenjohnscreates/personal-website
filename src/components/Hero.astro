<section
  class="min-h-[70vh] flex flex-col justify-center px-5 pt-12 pb-4 md:pt-14 md:pb-6"
>
  <div
    class="mx-auto max-w-3xl md:max-w-4xl lg:max-w-5xl xl:max-w-6xl w-full text-center"
  >
    <div class="reveal mb-3">
      <h1>
        <img
          src="/kenny-johns-wordmark.png"
          alt="Kenny Johns"
          class="mx-auto w-[88%] sm:w-full max-w-xl md:max-w-2xl lg:max-w-3xl"
        />
      </h1>
    </div>
    <p
      class="reveal mx-auto max-w-2xl lg:max-w-3xl text-balance text-lg sm:text-xl md:text-2xl leading-relaxed text-dark font-body mb-4"
      style="animation-delay: 120ms;"
    >
      GTM & Solutions Lead. 17 years with clients like: National Geographic,
      Discovery, Google and The World Bank; a startup grown from zero, and
      award winning AI tools built along the way.
    </p>
    <p
      class="reveal mx-auto max-w-xl lg:max-w-2xl text-balance italic text-sm sm:text-base md:text-lg leading-relaxed text-dark/70 font-body mb-10"
      style="animation-delay: 180ms;"
    >
      Well versed in multi-platform content delivery, SEO/AI SEO and agentic
      automation processes; open to contract and full-time roles.
    </p>
    <div
      class="reveal text-center flex flex-wrap items-center justify-center gap-3"
      style="animation-delay: 240ms;"
    >
      <a
        href="#reel"
        class="inline-flex items-center gap-2 bg-blue text-cream px-7 py-3.5 rounded-full font-display font-medium text-base hover:bg-dark transition-colors duration-300"
      >
        Watch Reel
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          class="mt-0.5"
        >
          <path
            d="M8 3v10M8 13l4-4M8 13L4 9"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <a
        href="https://savvycal.com/Kenny-Johns-Personal/chat"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-coral text-cream px-7 py-3.5 rounded-full font-display font-medium text-base hover:bg-dark transition-colors duration-300"
      >
        Book a call
      </a>
    </div>
  </div>
</section>
